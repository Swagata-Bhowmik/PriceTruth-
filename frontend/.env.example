# Frontend environment variables (Vite).
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Base URL for the backend API.
# Leave empty for local development: the Vite dev-server proxy forwards
# /api and /health to http://localhost:8000 (see vite.config.js).
# In production, set this to the deployed backend origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
