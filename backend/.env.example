# Price Truth backend environment configuration (TEMPLATE)
#
# Copy this file to `.env` and adjust the values for your environment:
#     cp .env.example .env        (macOS/Linux)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# The real `.env` file is gitignored and MUST NOT be committed. Production
# deployments (Vercel / Railway) inject these values as environment variables
# rather than using a committed file. No real secrets belong in this template.

# PostgreSQL connection URL (SQLAlchemy format).
# Local dev default; use the docker-compose service host `db` when running
# inside the compose network.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pricetruth_db

# Redis connection URL used for caching.
REDIS_URL=redis://localhost:6379/0

# Open Food Facts public API base URL and version.
# v2 is the current default; it can be upgraded (e.g. to v3) via config only.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_VERSION=v2

# The single frontend origin allowed to make cross-origin (CORS) requests.
CORS_ALLOWED_ORIGIN=http://localhost:5173
